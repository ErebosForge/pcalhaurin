---
import BaseLayout from '../../layouts/BaseLayout.astro';
import InfoPage from '../../components/InfoPage.astro';
import { en } from '../../data/en';

const page = en.pages.services;
---
<BaseLayout
  content={en}
  path="/en/services/"
  altPath="/servicios/"
  altLang="es"
  title={page.metaTitle}
  description={page.description}
>
  <InfoPage content={en} page={page} canonical="https://pcalhaurin.es/en/services/" showServices={true} />
</BaseLayout>