:80 {
    root * /srv
    file_server
    encode gzip

    # www → non-www redirect
    @www host www.pcalhaurin.es
    redir @www https://pcalhaurin.es{uri} permanent

    # Cache static assets aggressively (images, css, js)
    @static path *.css *.js *.jpg *.png *.webp *.ico *.svg *.woff2
    header @static Cache-Control "public, max-age=31536000, immutable"

    # HTML: revalidate (so deploys take effect immediately)
    @html path *.html /
    header @html Cache-Control "public, max-age=3600, must-revalidate"

    # Security headers
    header {
        X-Content-Type-Options "nosniff"
        X-Frame-Options "DENY"
        Referrer-Policy "strict-origin-when-cross-origin"
    }

    # The site is static (Astro output): existing files/directories are served
    # normally; unknown URLs must remain real 404 responses.
}
