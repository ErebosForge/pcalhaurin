---
import BaseLayout from '../../layouts/BaseLayout.astro';
import InfoPage from '../../components/InfoPage.astro';
import { en } from '../../data/en';

const page = en.pages.howWeWork;
---
<BaseLayout
  content={en}
  path="/en/how-we-work/"
  altPath="/como-trabajamos/"
  altLang="es"
  title={page.metaTitle}
  description={page.description}
>
  <InfoPage content={en} page={page} canonical="https://pcalhaurin.es/en/how-we-work/" />
</BaseLayout>