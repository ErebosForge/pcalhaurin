---
import BaseLayout from '../layouts/BaseLayout.astro';
import InfoPage from '../components/InfoPage.astro';
import { es } from '../data/es';

const page = es.pages.homeVisits;
---
<BaseLayout
  content={es}
  path="/a-domicilio/"
  altPath="/en/home-visits/"
  altLang="en"
  title={page.metaTitle}
  description={page.description}
>
  <InfoPage content={es} page={page} canonical="https://pcalhaurin.es/a-domicilio/" showZones={true} />
</BaseLayout>