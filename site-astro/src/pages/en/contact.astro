---
import BaseLayout from '../../layouts/BaseLayout.astro';
import InfoPage from '../../components/InfoPage.astro';
import { en } from '../../data/en';

const page = en.pages.contact;
---
<BaseLayout
  content={en}
  path="/en/contact/"
  altPath="/contacto/"
  altLang="es"
  title={page.metaTitle}
  description={page.description}
>
  <InfoPage content={en} page={page} canonical="https://pcalhaurin.es/en/contact/" showContact={true} />
</BaseLayout>